---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config/site';
const endpoint = SITE.contactFormAction;
const labels: Record<string, string> = { github: 'GitHub', linkedin: 'LinkedIn', x: 'X', youtube: 'YouTube' };
const socials = Object.entries(SITE.social).filter(([, v]) => v);
---

<BaseLayout title="Contact" description="Contact the author with questions, corrections or topic requests.">
  <div class="container">
    <header class="page-head">
      <p class="eyebrow"><span>Contact</span></p>
      <h1 class="display">Say hello</h1>
      <p>Questions, corrections or topic requests are welcome.</p>
    </header>
    <div class="contact section--tight">
      <form class="form" id="contact-form" action={endpoint || undefined} method={endpoint ? 'post' : undefined} data-mail={SITE.contactEmail} data-endpoint={endpoint || undefined}>
        <div class="field"><label for="name">Name</label><input class="input" id="name" name="name" placeholder="Your name" required autocomplete="name" /></div>
        <div class="field"><label for="email">Email</label><input class="input" id="email" type="email" name="email" placeholder="you@example.com" required autocomplete="email" /></div>
        <div class="field"><label for="msg">Message</label><textarea class="textarea" id="msg" name="message" placeholder="How can I help?" required></textarea></div>
        <!-- Honeypot: real people never see or fill this in; bots do. -->
        <div class="hp" aria-hidden="true"><label>Leave this empty<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label></div>
        <div class="form__actions">
          <button class="btn btn--primary" type="submit">{endpoint ? 'Send message' : 'Open in my email app'}</button>
          <p class="status" id="form-status" role="status" aria-live="polite"></p>
        </div>
      </form>
      <aside class="side-card" aria-label="Other ways to reach me">
        <h2>Prefer email?</h2>
        <p><a class="mail" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></p>
        {socials.length > 0 && (
          <>
            <h2>Find me online</h2>
            <ul class="social-list" role="list">
              {socials.map(([k, v]) => <li><a href={v} target="_blank" rel="noopener me"><Icon name={k} />{labels[k] ?? k}</a></li>)}
            </ul>
          </>
        )}
      </aside>
    </div>
  </div>
  <script>
    import '../scripts/contact';
  </script>
</BaseLayout>
