---
import Icon from './Icon.astro';
---

<dialog class="palette" id="palette" aria-label="Search articles" data-palette>
  <div class="palette__field">
    <Icon name="search" size={20} />
    <input
      class="palette__input" id="palette-input" type="search" placeholder="Search guides, topics and tags"
      autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="search"
      role="combobox" aria-expanded="true" aria-controls="palette-list" aria-autocomplete="list" aria-label="Search articles"
    />
    <button class="icon-btn icon-btn--sm" type="button" data-palette-close aria-label="Close search"><Icon name="close" size={18} /></button>
  </div>
  <p class="palette__group" id="palette-group">Latest guides</p>
  <ul class="palette__list" id="palette-list" role="listbox" aria-labelledby="palette-group"></ul>
  <div class="palette__foot">
    <span class="palette__hints"><kbd class="kbd">↑</kbd> <kbd class="kbd">↓</kbd> to move <kbd class="kbd">Enter</kbd> to open <kbd class="kbd">Esc</kbd> to close</span>
    <a class="grow" href="/search/" data-palette-all>Open full search</a>
  </div>
</dialog>
